rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic authentication helpers reused across rule sets.
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPostOwner(postData) {
      return postData.userId is string && isOwner(postData.userId);
    }

    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isCommentOwner(commentData) {
      return commentData.userId is string && isOwner(commentData.userId);
    }

    // Common field validation utilities for documents that include user entered text.
    function optionalStringMax(data, field, maxLength) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLength);
    }

    function requiredStringMax(data, field, maxLength) {
      return field in data && data[field] is string && data[field].size() > 0 && data[field].size() <= maxLength;
    }

    function matchesLowercase(data, sourceField, lowerField) {
      return !(sourceField in data) || (
        lowerField in data &&
        data[sourceField] is string &&
        data[lowerField] is string &&
        data[lowerField] == data[sourceField].lower()
      );
    }

    // Posts collection with nested comments.
    match /posts/{postId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && validatePostCreate();

      allow update: if isAuthenticated() && isPostOwner(resource.data) && validatePostUpdate();

      allow delete: if isAuthenticated() && isPostOwner(resource.data);

      function validatePostCreate() {
        return requiredStringMax(request.resource.data, "title", 100)
          && requiredStringMax(request.resource.data, "videoURL", 600)
          && requiredStringMax(request.resource.data, "userId", 128)
          && requiredStringMax(request.resource.data, "category", 100)
          && request.resource.data.timestamp is timestamp
          && request.resource.data.userId == request.auth.uid
          && optionalStringMax(request.resource.data, "description", 500)
          && optionalStringMax(request.resource.data, "location", 200);
      }

      function validatePostUpdate() {
        return request.resource.data.keys().hasAll(["title", "videoURL", "userId", "category", "timestamp"])
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.timestamp == resource.data.timestamp
          && validatePostCreate();
      }

      // Nested comments behave like light-weight posts – readable by everyone, owned by the author.
      match /comments/{commentId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated() && validateCommentCreate();

        allow delete: if isAuthenticated() && isCommentOwner(resource.data);

        allow update: if false; // Comments are immutable after creation to simplify moderation.

        function validateCommentCreate() {
          return requiredStringMax(request.resource.data, "content", 1000)
            && requiredStringMax(request.resource.data, "userId", 128)
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.timestamp is timestamp;
        }
      }
    }

    // Users collection controls profile data (display names, following, etc.).
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if (isOwner(userId) && validateUserOwnerCreate())
        || (isAdmin() && validateUserAdminWrite());

      allow update: if (isOwner(userId) && validateUserOwnerUpdate())
        || (isAdmin() && validateUserAdminWrite());

      allow delete: if false; // Profile deletion is not supported – handled through account management flows.

      function hasProtectedEditorialFields(data) {
        return data.keys().hasAny([
          "accountType",
          "isSeedAccount",
          "officialLabel",
          "isVerified",
          "handle",
          "handleLower",
          "createdAt",
          "createdBy"
        ]);
      }

      function protectedEditorialFieldsUnchanged() {
        return !request.resource.data.diff(resource.data).changedKeys().hasAny([
          "accountType",
          "isSeedAccount",
          "officialLabel",
          "isVerified",
          "handle",
          "handleLower",
          "createdAt",
          "createdBy"
        ]);
      }

      function validateCommonUserFields() {
        return matchesLowercase(request.resource.data, "displayName", "displayNameLower")
          && matchesLowercase(request.resource.data, "handle", "handleLower")
          && optionalStringMax(request.resource.data, "displayName", 60)
          && optionalStringMax(request.resource.data, "displayNameLower", 60)
          && optionalStringMax(request.resource.data, "officialLabel", 80)
          && optionalStringMax(request.resource.data, "handle", 40)
          && optionalStringMax(request.resource.data, "handleLower", 40)
          && optionalStringMax(request.resource.data, "cityName", 80)
          && optionalStringMax(request.resource.data, "countryCode", 4)
          && (!( "accountType" in request.resource.data) || request.resource.data.accountType in ["user", "editorial"])
          && (!( "isSeedAccount" in request.resource.data) || request.resource.data.isSeedAccount is bool)
          && (!( "isVerified" in request.resource.data) || request.resource.data.isVerified is bool)
          && (!( "createdBy" in request.resource.data) || request.resource.data.createdBy is string)
          && (!( "createdAt" in request.resource.data) || request.resource.data.createdAt is timestamp)
          && optionalStringMax(request.resource.data, "bio", 280)
          && (!( "geoLocation" in request.resource.data) || (
            request.resource.data.geoLocation is map &&
            request.resource.data.geoLocation.lat is number &&
            request.resource.data.geoLocation.lng is number
          ))
          && (!( "cityLocation" in request.resource.data) || (
            request.resource.data.cityLocation is map &&
            request.resource.data.cityLocation.lat is number &&
            request.resource.data.cityLocation.lng is number
          ))
          && (!("following" in request.resource.data) || request.resource.data.following is list);
      }

      function validateUserOwnerCreate() {
        return validateCommonUserFields() && isOwner(userId) && !hasProtectedEditorialFields(request.resource.data);
      }

      function validateUserOwnerUpdate() {
        return validateCommonUserFields() && isOwner(userId) && protectedEditorialFieldsUnchanged();
      }

      function validateUserAdminWrite() {
        return validateCommonUserFields();
      }
    }

    // Canonical handle registry for case-insensitive uniqueness.
    match /handles/{handleLower} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() && validateHandleWrite(handleLower);

      function validateHandleWrite(handleLower) {
        return request.resource.data.uid is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.type in ["user", "editorial"]
          && handleLower == handleLower.lower();
      }
    }

    // MVP admin model: existence of /admins/{uid} marks admin status.
    match /admins/{adminUid} {
      allow read: if isOwner(adminUid) || isAdmin();
      allow create, update, delete: if false;
    }

    // Venues and events are publicly readable, admin-seeded only.
    match /venues/{venueId} {
      allow read: if true;
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
